set background=dark
syntax enable
set mouse=a "yeah, not a true keyboard warrior. fite me

set number
set relativenumber

" Indentation style
set shiftwidth=4
set tabstop=4
set softtabstop=4
set expandtab

"TODO: revisit these; these are from that time i tried to really go and learn vimscript

let mapleader = ","
let maplocalleader = "\\"

set pastetoggle=<F2>

nnoremap <leader>ev :split $MYVIMRC<cr>
nnoremap <leader>sv :source $MYVIMRC<cr>

"Disable arrow keys, to force myself to get more comfortable hjkl-ing
noremap <up> <nop>
noremap <down> <nop>
noremap <left> <nop>
noremap <right> <nop>
